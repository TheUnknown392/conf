! Clear CapsLock's default lock behavior first
clear Lock

! Make CapsLock behave as Control_L (base layer)
keycode 66 = Control_L NoSymbol Control_L

! Right Super -> Ctrl
keycode 134 = Control_R NoSymbol Control_R

! Menu key -> Super
keycode 135 = Super_L NoSymbol Super_L

! Ensure both physical Ctrl_L and the new CapsLock-as-Ctrl are in the Control modifier group
clear Control
add Control = Control_L Control_R

! Keep Super mapping intact for both original Supers and the new Menu-as-Super
clear Mod4
add Mod4 = Super_L Super_R